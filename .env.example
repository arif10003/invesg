# Public API origin only. Never place database, SMTP, or provider secrets in VITE_* variables.
# Leave empty when the production host proxies /api/v1 to the backend.
VITE_API_BASE_URL=

# MVP member/commerce endpoints are not configured yet. Do not enable them with
